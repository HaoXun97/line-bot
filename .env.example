# Copy to .env and fill values
# MS SQL config
MSSQL_HOST = localhost
MSSQL_PORT = 1433
MSSQL_USER = user
MSSQL_PASSWORD = password
MSSQL_TABLE = trade_signals_1d
MSSQL_DATABASE = market_stock_tw
USER_DATA_DATABASE = user_data

# Poll interval in seconds
POLL_INTERVAL = 10

# Column to use as unique ID (e.g., primary key or created_at)
ID_COLUMN = id
# Optional: if your table contains a timestamp column use it to detect new rows
# TIME_COLUMN = created_at

# LINE Bot credentials
LINE_CHANNEL_ACCESS_TOKEN = token
LINE_CHANNEL_SECRET = secret
ALLOW_UNVERIFIED_WEBHOOK = true

# Optional filter SQL WHERE clause (without the WHERE keyword)
# FILTER_CLAUSE = processed = 0

# Message template (can include placeholders like {{id}} and other column names)
MESSAGE_TEMPLATE = 【{{symbol}}】{{Trade_Signal}} at {{close_price}} (id: {{id}}, time: {{datetime}})

# Server port (optional)
PORT = 80
